# Auto-populated when you connect Supabase via the Vercel Marketplace.
# For local dev, copy this file to .env.local and paste values from Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_service_key_here

# Optional: Set a passcode to lock the Live Vote Graph for organizers only.
# Leave blank to keep the results graph public for all students.
NEXT_PUBLIC_RESULTS_PASSCODE=
